{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "sortImports": { "enabled": true },
  "sortTailwindcss": {
    "enabled": true,
    "stylesheet": "app/globals.css"
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/public/**",
    "bun.lock",
    "bun.lockb",
    "**/*.min.js",
    "**/*.md",
    "**/next-env.d.ts"
  ],
  "overrides": [
    {
      "files": ["**/*.{yml,yaml}"],
      "options": { "tabWidth": 2 }
    }
  ]
}
